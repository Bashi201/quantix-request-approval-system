{
  "info": {
    "_postman_id": "b3e94a82-f5c2-4011-88f1-8319e7a89201",
    "name": "Quantix Service Request & Approval API",
    "description": "Comprehensive RESTful API Collection for the Quantix SaaS Service Request & Approval Platform.\n\nIncludes complete role-based requests for Employees, Managers, and Operations Users.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "requestId",
      "value": "1",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "01 - Authentication",
      "item": [
        {
          "name": "Login - Employee (Alice Smith)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set('token', jsonData.data.token);",
                  "    console.log('Token updated for Alice Smith');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice.dev@quantix.io\",\n  \"password\": \"password\"\n}"
            },
            "url": "{{baseUrl}}/login"
          }
        },
        {
          "name": "Login - Manager (Sarah Connor)",
          "event": [
            {
              "listen": "test",
              "script": {
